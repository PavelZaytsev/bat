diff --git a/src/main/java/canary/PairKey.java b/src/main/java/canary/PairKey.java
index 94b0e90..eaeff64 100644
--- a/src/main/java/canary/PairKey.java
+++ b/src/main/java/canary/PairKey.java
@@ -4,6 +4,9 @@ public final class PairKey {
     private PairKey() {}
 
     public static String join(final String left, final String right) {
+        if (left.isEmpty()) {
+            return right;
+        }
         return left + ":" + right;
     }
 }
diff --git a/src/test/java/canary/PairKeyTest.java b/src/test/java/canary/PairKeyTest.java
index 80a72a1..8a73848 100644
--- a/src/test/java/canary/PairKeyTest.java
+++ b/src/test/java/canary/PairKeyTest.java
@@ -2,6 +2,12 @@ package canary;
 
 public final class PairKeyTest {
     public static void main(final String[] args) {
+        // EXPOSE: an empty left must not produce a leading separator.
+        assertEquals("beta", PairKey.join("", "beta"));
+        // SATURATE: the full 2x2 input space (left empty|non-empty x right empty|non-empty).
+        assertEquals("", PairKey.join("", ""));
+        assertEquals("alpha:", PairKey.join("alpha", ""));
+        // Existing non-empty behavior, preserved.
         assertEquals("alpha:beta", PairKey.join("alpha", "beta"));
         System.out.println("PairKeyTest passed");
     }

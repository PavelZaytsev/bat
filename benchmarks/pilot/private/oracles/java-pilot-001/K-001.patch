+package org.apache.commons.pool2.impl;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.apache.commons.pool2.BasePooledObjectFactory;
+import org.apache.commons.pool2.PooledObject;
+import org.junit.jupiter.api.Test;
+
+class PoolUnlimitedMaxIdleHiddenTest {
+
+    @Test
+    void unlimitedMaxIdleStillAllowsAddingAnIdleObject() throws Exception {
+        final BasePooledObjectFactory<String> factory = new BasePooledObjectFactory<String>() {
+            @Override
+            public String create() {
+                return "value";
+            }
+
+            @Override
+            public PooledObject<String> wrap(final String value) {
+                return new DefaultPooledObject<>(value);
+            }
+        };
+
+        try (GenericObjectPool<String> pool = new GenericObjectPool<>(factory)) {
+            pool.setMaxIdle(-1);
+            pool.addObject();
+            assertEquals(1, pool.getNumIdle());
+        }
+    }
+}

#!/usr/bin/env sh
set -eu

BDR_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$BDR_BIN_DIR/../scripts/bdr.py" "$@"
fi

if command -v python >/dev/null 2>&1; then
  exec python "$BDR_BIN_DIR/../scripts/bdr.py" "$@"
fi

echo "bdr: Python 3.10 or newer is required" >&2
exit 127
